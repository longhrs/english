      "title_en": "My five senses",
      "title_cn": "我的五种感官",
      "topic": "Senses",
      "overview": "用 look、listen、smell、taste、touch 描述自己怎样感知世界，并学会 I can ... 句型。",
      "phonics": {
        "focus": "字母组合 ee /iː/",
        "tip": "嘴角向两边展开，声音拉长，像汉语「衣」但更长。",
        "examples": ["see /siː/ 看见", "feel /fiːl/ 感觉", "sweet /swiːt/ 甜的"]
      },
      "words": [
        {"en": "see", "ipa": "/siː/", "pos": "v.", "cn": "看见", "ex_en": "I can see a bird.", "ex_cn": "我能看见一只鸟。"},
        {"en": "hear", "ipa": "/hɪə/", "pos": "v.", "cn": "听见", "ex_en": "I can hear the rain.", "ex_cn": "我能听见雨声。"},
        {"en": "smell", "ipa": "/smel/", "pos": "v.", "cn": "闻", "ex_en": "Smell the flower.", "ex_cn": "闻一闻这朵花。"},
        {"en": "taste", "ipa": "/teɪst/", "pos": "v.", "cn": "尝", "ex_en": "Taste the soup.", "ex_cn": "尝一尝这汤。"},
        {"en": "touch", "ipa": "/tʌtʃ/", "pos": "v.", "cn": "触摸", "ex_en": "Do not touch it.", "ex_cn": "不要摸它。"},
        {"en": "look", "ipa": "/lʊk/", "pos": "v.", "cn": "看", "ex_en": "Look at the blackboard.", "ex_cn": "看黑板。"},
        {"en": "listen", "ipa": "/ˈlɪsn/", "pos": "v.", "cn": "听", "ex_en": "Listen to me, please.", "ex_cn": "请听我说。"},
        {"en": "sweet", "ipa": "/swiːt/", "pos": "adj.", "cn": "甜的", "ex_en": "The cake is sweet.", "ex_cn": "这个蛋糕很甜。"},
        {"en": "loud", "ipa": "/laʊd/", "pos": "adj.", "cn": "大声的", "ex_en": "The music is loud.", "ex_cn": "音乐声很大。"},
        {"en": "soft", "ipa": "/sɒft/", "pos": "adj.", "cn": "柔软的", "ex_en": "The toy bear is soft.", "ex_cn": "这只玩具熊很软。"}
      ],
      "patterns": [
        {"en": "I can see ... .", "cn": "我能看见……。", "examples": [
          {"en": "I can see a bird.", "cn": "我能看见一只鸟。"},
          {"en": "I can hear a dog.", "cn": "我能听见一只狗。"}
        ]},
        {"en": "It smells nice.", "cn": "它闻起来很香。", "examples": [
          {"en": "It smells nice.", "cn": "它闻起来很香。"},
          {"en": "It tastes sweet.", "cn": "它尝起来很甜。"}
        ]},
        {"en": "Look at the ... .", "cn": "看这个……。", "examples": [
          {"en": "Look at the flower.", "cn": "看这朵花。"},
          {"en": "Listen to the music.", "cn": "听这段音乐。"}
        ]}
      ],
      "grammar": [
        {"title": "can 后面用动词原形", "explain": "can 表示「能、会」，后面的动词不加 -s 也不加 -ing：I can see. 否定是 I cannot see.", "examples": [
          {"en": "I can hear you.", "cn": "我能听见你。"},
          {"en": "She can smell the soup.", "cn": "她能闻到汤的味道。"}
        ]},
        {"title": "look at / listen to 的搭配", "explain": "look 后面要加 at，listen 后面要加 to，不能漏掉。", "examples": [
          {"en": "Look at me.", "cn": "看着我。"},
          {"en": "Listen to the teacher.", "cn": "听老师讲。"}
        ]}
      ],
      "tips": ["闭上眼睛让同桌发出声音，用 I can hear ... 来猜，练习听力词汇。"]
    },
