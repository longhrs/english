        {"en": "proud", "ipa": "/praʊd/", "pos": "adj.", "cn": "自豪的", "ex_en": "I am proud of my class.", "ex_cn": "我为我的班级自豪。"},
        {"en": "competition", "ipa": "/ˌkɒmpəˈtɪʃn/", "pos": "n.", "cn": "比赛", "ex_en": "We won the speech competition.", "ex_cn": "我们赢得了演讲比赛。"}
      ],
      "patterns": [
        {"en": "We must ... at school.", "cn": "在学校我们必须……。", "examples": [
          {"en": "We must be on time.", "cn": "我们必须准时。"},
          {"en": "We must not run in the hallway.", "cn": "我们不可以在走廊里跑。"}
        ]},
        {"en": "Would you like to join ... ?", "cn": "你想加入……吗？", "examples": [
          {"en": "Would you like to join the art club?", "cn": "你想加入美术社吗？"},
          {"en": "Yes, I would love to.", "cn": "好的，我很乐意。"}
        ]},
        {"en": "I am proud of ... .", "cn": "我为……感到自豪。", "examples": [
          {"en": "I am proud of our team.", "cn": "我为我们的队伍感到自豪。"},
          {"en": "She is proud of her work.", "cn": "她为自己的作品感到自豪。"}
        ]}
      ],
      "grammar": [
        {"title": "must 与 have to", "explain": "must 强调说话人认为必须；have to 强调客观要求。否定 must not 是「禁止」，do not have to 是「不必」。", "examples": [
          {"en": "You must finish your homework.", "cn": "你必须完成作业。"},
          {"en": "You do not have to come early.", "cn": "你不必早到。"}
