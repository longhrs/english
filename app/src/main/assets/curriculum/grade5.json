        {"en": "rule", "ipa": "/ruːl/", "pos": "n.", "cn": "规则", "ex_en": "We must follow the school rules.", "ex_cn": "我们必须遵守校规。"},
        {"en": "quiet", "ipa": "/ˈkwaɪət/", "pos": "adj.", "cn": "安静的", "ex_en": "Be quiet in the library.", "ex_cn": "在图书馆要安静。"},
        {"en": "tidy", "ipa": "/ˈtaɪdi/", "pos": "adj./v.", "cn": "整洁的；整理", "ex_en": "Keep your desk tidy.", "ex_cn": "保持桌面整洁。"},
