        {"en": "timetable", "ipa": "/ˈtaɪmteɪbl/", "pos": "n.", "cn": "课程表", "ex_en": "Look at our timetable.", "ex_cn": "看看我们的课程表。"},
        {"en": "favourite", "ipa": "/ˈfeɪvərɪt/", "pos": "adj.", "cn": "最喜欢的", "ex_en": "Music is my favourite lesson.", "ex_cn": "音乐是我最喜欢的课。"}
      ],
      "patterns": [
        {"en": "There is a ... in our school.", "cn": "我们学校里有一个……。", "examples": [
          {"en": "There is a big playground in our school.", "cn": "我们学校有一个大操场。"},
          {"en": "There are two libraries in our school.", "cn": "我们学校有两个图书馆。"}
        ]},
        {"en": "What is your favourite subject?", "cn": "你最喜欢哪门科目？", "examples": [
          {"en": "What is your favourite subject?", "cn": "你最喜欢哪门科目？"},
          {"en": "My favourite subject is English.", "cn": "我最喜欢的科目是英语。"}
        ]},
        {"en": "We have ... on Monday.", "cn": "我们周一有……课。", "examples": [
          {"en": "We have art on Monday.", "cn": "我们周一有美术课。"},
          {"en": "We have PE on Friday.", "cn": "我们周五有体育课。"}
        ]}
      ],
      "grammar": [
        {"title": "There is 和 There are", "explain": "表示某处有某物：后面是单数或不可数名词用 There is，是复数用 There are。", "examples": [
          {"en": "There is a hall in our school.", "cn": "我们学校有一个礼堂。"},
          {"en": "There are many trees on the playground.", "cn": "操场上有很多树。"}
