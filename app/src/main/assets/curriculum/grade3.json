        {"en": "teacher", "ipa": "/ˈtiːtʃə/", "pos": "n.", "cn": "老师", "ex_en": "My teacher is kind.", "ex_cn": "我的老师很和蔼。"},
        {"en": "student", "ipa": "/ˈstjuːdnt/", "pos": "n.", "cn": "学生", "ex_en": "There are forty students in my class.", "ex_cn": "我班有四十名学生。"},
