      "patterns": [
        {"en": "What time is it?", "cn": "现在几点？", "examples": [
          {"en": "What time is it?", "cn": "现在几点？"},
          {"en": "It is half past six.", "cn": "现在六点半。"}
        ]},
        {"en": "I have ... at ... .", "cn": "我在……点吃……。", "examples": [
          {"en": "I have lunch at twelve.", "cn": "我十二点吃午饭。"},
          {"en": "I have dinner at six.", "cn": "我六点吃晚饭。"}
        ]},
        {"en": "What time do you ... ?", "cn": "你几点……？", "examples": [
          {"en": "What time do you get up?", "cn": "你几点起床？"},
          {"en": "I get up at six thirty.", "cn": "我六点半起床。"}
