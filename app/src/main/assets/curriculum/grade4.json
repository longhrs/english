      "title_en": "Hobbies",
      "title_cn": "兴趣爱好",
      "topic": "Hobbies",
      "overview": "谈论自己和别人的爱好，学会用 like doing 和 be good at。",
      "phonics": {
        "focus": "动词 -ing 的读音 /ɪŋ/",
        "tip": "swimming、singing 结尾的 ng 是一个鼻音，不要加 /g/ 的爆破。",
        "examples": ["singing /ˈsɪŋɪŋ/ 唱歌", "swimming /ˈswɪmɪŋ/ 游泳", "drawing /ˈdrɔːɪŋ/ 画画"]
      },
      "words": [
        {"en": "hobby", "ipa": "/ˈhɒbi/", "pos": "n.", "cn": "爱好", "ex_en": "Reading is my hobby.", "ex_cn": "阅读是我的爱好。"},
        {"en": "swim", "ipa": "/swɪm/", "pos": "v.", "cn": "游泳", "ex_en": "I swim twice a week.", "ex_cn": "我每周游泳两次。"},
        {"en": "dance", "ipa": "/dɑːns/", "pos": "v./n.", "cn": "跳舞", "ex_en": "She likes dancing.", "ex_cn": "她喜欢跳舞。"},
        {"en": "sing", "ipa": "/sɪŋ/", "pos": "v.", "cn": "唱歌", "ex_en": "We sing English songs.", "ex_cn": "我们唱英文歌。"},
        {"en": "draw", "ipa": "/drɔː/", "pos": "v.", "cn": "画画", "ex_en": "He can draw very well.", "ex_cn": "他画画很棒。"},
        {"en": "collect", "ipa": "/kəˈlekt/", "pos": "v.", "cn": "收集", "ex_en": "I collect stamps.", "ex_cn": "我收集邮票。"},
        {"en": "stamp", "ipa": "/stæmp/", "pos": "n.", "cn": "邮票", "ex_en": "This stamp is from Japan.", "ex_cn": "这枚邮票来自日本。"},
        {"en": "chess", "ipa": "/tʃes/", "pos": "n.", "cn": "国际象棋", "ex_en": "We play chess on Sunday.", "ex_cn": "我们周日下棋。"},
        {"en": "piano", "ipa": "/piˈænəʊ/", "pos": "n.", "cn": "钢琴", "ex_en": "She plays the piano well.", "ex_cn": "她钢琴弹得很好。"},
        {"en": "football", "ipa": "/ˈfʊtbɔːl/", "pos": "n.", "cn": "足球", "ex_en": "We play football after school.", "ex_cn": "放学后我们踢足球。"},
        {"en": "basketball", "ipa": "/ˈbɑːskɪtbɔːl/", "pos": "n.", "cn": "篮球", "ex_en": "Basketball is popular here.", "ex_cn": "篮球在这里很受欢迎。"},
        {"en": "interesting", "ipa": "/ˈɪntrəstɪŋ/", "pos": "adj.", "cn": "有趣的", "ex_en": "Chess is interesting.", "ex_cn": "国际象棋很有趣。"}
      ],
      "patterns": [
        {"en": "What is your hobby?", "cn": "你的爱好是什么？", "examples": [
          {"en": "What is your hobby?", "cn": "你的爱好是什么？"},
          {"en": "My hobby is drawing.", "cn": "我的爱好是画画。"}
        ]},
        {"en": "I like ... very much.", "cn": "我非常喜欢做……。", "examples": [
          {"en": "I like swimming very much.", "cn": "我非常喜欢游泳。"},
          {"en": "She likes singing.", "cn": "她喜欢唱歌。"}
        ]},
        {"en": "He is good at ... .", "cn": "他擅长……。", "examples": [
          {"en": "He is good at basketball.", "cn": "他擅长打篮球。"},
          {"en": "I am good at drawing.", "cn": "我擅长画画。"}
        ]}
      ],
      "grammar": [
        {"title": "like 后面接动词 -ing", "explain": "表示习惯性喜好时用 like doing：I like swimming. 也可以说 like to do。", "examples": [
          {"en": "I like reading books.", "cn": "我喜欢看书。"},
          {"en": "They like playing chess.", "cn": "他们喜欢下棋。"}
        ]},
        {"title": "球类不加 the，乐器加 the", "explain": "play football、play basketball 不加 the；play the piano、play the violin 要加 the。", "examples": [
          {"en": "She plays the piano.", "cn": "她弹钢琴。"},
          {"en": "We play football.", "cn": "我们踢足球。"}
        ]}
      ],
      "tips": ["做一个 hobby survey，问 5 位同学 What is your hobby? 并记录答案。"]
    },
    {
      "id": "g4u2",
      "no": 2,
      "title_en": "Festivals",
      "title_cn": "节日",
      "topic": "Festivals",
      "overview": "介绍中国传统节日和节日活动，学会用一般将来时谈计划。",
      "phonics": {
        "focus": "字母组合 al /ɔːl/ 与 /əl/",
        "tip": "tall、ball 中的 al 读 /ɔːl/；festival 结尾的 -al 轻读为 /əl/。",
        "examples": ["festival /ˈfestɪvl/ 节日", "tall /tɔːl/ 高的", "small /smɔːl/ 小的"]
      },
      "words": [
        {"en": "festival", "ipa": "/ˈfestɪvl/", "pos": "n.", "cn": "节日", "ex_en": "The Spring Festival is important.", "ex_cn": "春节很重要。"},
        {"en": "holiday", "ipa": "/ˈhɒlədeɪ/", "pos": "n.", "cn": "假期", "ex_en": "We have a long holiday.", "ex_cn": "我们有一个长假。"},
        {"en": "celebrate", "ipa": "/ˈselɪbreɪt/", "pos": "v.", "cn": "庆祝", "ex_en": "We celebrate with our family.", "ex_cn": "我们和家人一起庆祝。"},
        {"en": "lantern", "ipa": "/ˈlæntən/", "pos": "n.", "cn": "灯笼", "ex_en": "We hang red lanterns.", "ex_cn": "我们挂红灯笼。"},
        {"en": "mooncake", "ipa": "/ˈmuːnkeɪk/", "pos": "n.", "cn": "月饼", "ex_en": "We eat mooncakes in autumn.", "ex_cn": "秋天我们吃月饼。"},
        {"en": "dumpling", "ipa": "/ˈdʌmplɪŋ/", "pos": "n.", "cn": "饺子", "ex_en": "My grandma makes dumplings.", "ex_cn": "我奶奶包饺子。"},
        {"en": "dragon", "ipa": "/ˈdræɡən/", "pos": "n.", "cn": "龙", "ex_en": "We watch dragon boat races.", "ex_cn": "我们看龙舟比赛。"},
        {"en": "present", "ipa": "/ˈpreznt/", "pos": "n.", "cn": "礼物", "ex_en": "I get presents from my parents.", "ex_cn": "我收到父母的礼物。"},
        {"en": "autumn", "ipa": "/ˈɔːtəm/", "pos": "n.", "cn": "秋天", "ex_en": "Autumn here is warm.", "ex_cn": "这里的秋天很暖和。"},
        {"en": "visit", "ipa": "/ˈvɪzɪt/", "pos": "v.", "cn": "拜访；参观", "ex_en": "We visit our grandparents.", "ex_cn": "我们去看望祖父母。"},
        {"en": "fireworks", "ipa": "/ˈfaɪəwɜːks/", "pos": "n.", "cn": "烟花", "ex_en": "The fireworks are beautiful.", "ex_cn": "烟花很漂亮。"},
        {"en": "happy", "ipa": "/ˈhæpi/", "pos": "adj.", "cn": "快乐的", "ex_en": "Happy New Year!", "ex_cn": "新年快乐！"}
      ],
      "patterns": [
        {"en": "What do you do at ... ?", "cn": "……的时候你们做什么？", "examples": [
          {"en": "What do you do at the Spring Festival?", "cn": "春节你们做什么？"},
          {"en": "We eat dumplings and visit our family.", "cn": "我们吃饺子、走亲戚。"}
        ]},
        {"en": "I am going to ... .", "cn": "我打算……。", "examples": [
          {"en": "I am going to visit my grandma.", "cn": "我打算去看望奶奶。"},
          {"en": "We are going to watch fireworks.", "cn": "我们打算去看烟花。"}
        ]},
        {"en": "My favourite festival is ... .", "cn": "我最喜欢的节日是……。", "examples": [
          {"en": "My favourite festival is the Mid-Autumn Festival.", "cn": "我最喜欢的节日是中秋节。"},
          {"en": "Because we eat mooncakes together.", "cn": "因为我们一起吃月饼。"}
        ]}
      ],
      "grammar": [
        {"title": "一般将来时 be going to", "explain": "表示打算做的事：主语 + am/is/are going to + 动词原形。", "examples": [
          {"en": "I am going to see a film.", "cn": "我打算去看电影。"},
          {"en": "They are going to sing a song.", "cn": "他们打算唱一首歌。"}
        ]},
        {"title": "用 because 说明原因", "explain": "回答 Why 时用 because 引出原因，答句要完整：Because I like it.", "examples": [
          {"en": "I like it because it is fun.", "cn": "我喜欢它，因为它很有趣。"}
        ]}
      ],
      "tips": ["节日名称首字母要大写：the Spring Festival、the Mid-Autumn Festival、National Day。"]
    },
