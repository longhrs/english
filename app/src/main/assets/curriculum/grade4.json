        {"en": "station", "ipa": "/ˈsteɪʃn/", "pos": "n.", "cn": "车站", "ex_en": "The station is very busy.", "ex_cn": "车站很繁忙。"},
        {"en": "ticket", "ipa": "/ˈtɪkɪt/", "pos": "n.", "cn": "车票；门票", "ex_en": "Two tickets, please.", "ex_cn": "请给我两张票。"},
        {"en": "beach", "ipa": "/biːtʃ/", "pos": "n.", "cn": "海滩", "ex_en": "Dameisha has a nice beach.", "ex_cn": "大梅沙有一片漂亮的海滩。"},
        {"en": "museum", "ipa": "/mjuˈziːəm/", "pos": "n.", "cn": "博物馆", "ex_en": "The Shenzhen Museum is free.", "ex_cn": "深圳博物馆免费参观。"},
        {"en": "building", "ipa": "/ˈbɪldɪŋ/", "pos": "n.", "cn": "建筑物", "ex_en": "That building is very tall.", "ex_cn": "那座建筑很高。"},
        {"en": "tall", "ipa": "/tɔːl/", "pos": "adj.", "cn": "高的", "ex_en": "Ping An Tower is the tallest here.", "ex_cn": "平安大厦是这里最高的。"},
        {"en": "modern", "ipa": "/ˈmɒdn/", "pos": "adj.", "cn": "现代的", "ex_en": "Shenzhen is a modern city.", "ex_cn": "深圳是一座现代化城市。"},
        {"en": "bike", "ipa": "/baɪk/", "pos": "n.", "cn": "自行车", "ex_en": "We ride bikes in the park.", "ex_cn": "我们在公园骑自行车。"},
        {"en": "crowded", "ipa": "/ˈkraʊdɪd/", "pos": "adj.", "cn": "拥挤的", "ex_en": "The metro is crowded at eight.", "ex_cn": "八点时地铁很挤。"},
        {"en": "square", "ipa": "/skweə/", "pos": "n.", "cn": "广场", "ex_en": "We meet at the square.", "ex_cn": "我们在广场见面。"}
      ],
      "patterns": [
        {"en": "There are many ... in Shenzhen.", "cn": "深圳有很多……。", "examples": [
          {"en": "There are many parks in Shenzhen.", "cn": "深圳有很多公园。"},
          {"en": "There are many tall buildings in Futian.", "cn": "福田有很多高楼。"}
        ]},
        {"en": "I take the metro to ... .", "cn": "我坐地铁去……。", "examples": [
          {"en": "I take the metro to the museum.", "cn": "我坐地铁去博物馆。"},
          {"en": "We take the bus to the beach.", "cn": "我们坐公交车去海滩。"}
        ]},
        {"en": "It is famous for ... .", "cn": "它以……闻名。", "examples": [
          {"en": "Shenzhen is famous for technology.", "cn": "深圳以科技闻名。"},
          {"en": "Dapeng is famous for its sea.", "cn": "大鹏以大海闻名。"}
        ]}
      ],
      "grammar": [
        {"title": "形容词比较级", "explain": "两者比较时形容词加 -er，后接 than：tall → taller than。多音节词前加 more：more modern than。", "examples": [
          {"en": "This building is taller than that one.", "cn": "这座楼比那座高。"},
          {"en": "The metro is faster than the bus.", "cn": "地铁比公交快。"}
