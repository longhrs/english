        {"en": "headache", "ipa": "/ˈhedeɪk/", "pos": "n.", "cn": "头痛", "ex_en": "I have a headache.", "ex_cn": "我头疼。"},
        {"en": "medicine", "ipa": "/ˈmedsn/", "pos": "n.", "cn": "药", "ex_en": "Take the medicine twice a day.", "ex_cn": "这药一天吃两次。"},
        {"en": "rest", "ipa": "/rest/", "pos": "n./v.", "cn": "休息", "ex_en": "You should have a rest.", "ex_cn": "你应该休息一下。"},
