          {"en": "We love our family.", "cn": "我们爱我们的家。"}
        ]}
      ],
      "grammar": [
        {"title": "he 和 she 不要混用", "explain": "男性用 he（他），女性用 she（她）。中文里读音一样，英语里必须分清楚。", "examples": [
          {"en": "He is my brother.", "cn": "他是我的哥哥。"},
          {"en": "She is my sister.", "cn": "她是我的姐姐。"}
        ]},
        {"title": "my 表示「我的」", "explain": "my 后面一定要跟名词：my mother、my bag，不能单独使用。", "examples": [
          {"en": "my family", "cn": "我的家庭"}
        ]}
      ],
      "tips": ["向别人介绍家人照片时，先说 This is ...，再补一句 He/She is ...。"]
