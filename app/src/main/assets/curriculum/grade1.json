      "patterns": [
        {"en": "This is my ... .", "cn": "这是我的……。", "examples": [
          {"en": "This is my father.", "cn": "这是我的爸爸。"},
          {"en": "This is my sister.", "cn": "这是我的姐姐。"}
        ]},
        {"en": "Who is he or she?", "cn": "他/她是谁？", "examples": [
          {"en": "Who is she?", "cn": "她是谁？"},
          {"en": "She is my mother.", "cn": "她是我的妈妈。"}
        ]},
        {"en": "I love my family.", "cn": "我爱我的家人。", "examples": [
