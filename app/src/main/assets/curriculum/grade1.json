    {
      "id": "g1u1",
      "no": 1,
      "title_en": "Hello!",
      "title_cn": "问候与自我介绍",
      "topic": "Greetings",
      "overview": "学会用英语打招呼、介绍自己、认识老师和同学。这是英语课堂上每天都要用到的第一组表达。",
      "phonics": {
        "focus": "字母 Aa 的短音 /æ/",
        "tip": "嘴巴张大、舌头放平，像发汉语「啊」但更短促。",
        "examples": ["apple /ˈæpl/ 苹果", "bag /bæɡ/ 书包", "cat /kæt/ 猫"]
      },
      "words": [
        {"en": "hello", "ipa": "/həˈləʊ/", "pos": "int.", "cn": "你好", "ex_en": "Hello! I am Amy.", "ex_cn": "你好！我是艾米。"},
        {"en": "hi", "ipa": "/haɪ/", "pos": "int.", "cn": "嗨；你好", "ex_en": "Hi, Peter!", "ex_cn": "嗨，彼得！"},
        {"en": "I", "ipa": "/aɪ/", "pos": "pron.", "cn": "我", "ex_en": "I am a pupil.", "ex_cn": "我是一名小学生。"},
        {"en": "am", "ipa": "/æm/", "pos": "v.", "cn": "是", "ex_en": "I am six.", "ex_cn": "我六岁。"},
        {"en": "you", "ipa": "/juː/", "pos": "pron.", "cn": "你；你们", "ex_en": "How are you?", "ex_cn": "你好吗？"},
        {"en": "are", "ipa": "/ɑː/", "pos": "v.", "cn": "是", "ex_en": "You are my friend.", "ex_cn": "你是我的朋友。"},
        {"en": "name", "ipa": "/neɪm/", "pos": "n.", "cn": "名字", "ex_en": "My name is Kitty.", "ex_cn": "我的名字叫琪蒂。"},
        {"en": "Miss", "ipa": "/mɪs/", "pos": "n.", "cn": "小姐；女老师", "ex_en": "Good morning, Miss Li.", "ex_cn": "早上好，李老师。"},
        {"en": "goodbye", "ipa": "/ˌɡʊdˈbaɪ/", "pos": "int.", "cn": "再见", "ex_en": "Goodbye, Miss Chen!", "ex_cn": "再见，陈老师！"},
        {"en": "friend", "ipa": "/frend/", "pos": "n.", "cn": "朋友", "ex_en": "This is my friend.", "ex_cn": "这是我的朋友。"}
      ],
      "patterns": [
        {"en": "Hello! I am ...", "cn": "你好！我是……。", "examples": [
          {"en": "Hello! I am Amy.", "cn": "你好！我是艾米。"},
          {"en": "Hello! I am Tom.", "cn": "你好！我是汤姆。"}
        ]},
        {"en": "What is your name?", "cn": "你叫什么名字？", "examples": [
          {"en": "What is your name?", "cn": "你叫什么名字？"},
          {"en": "My name is Kitty.", "cn": "我的名字叫琪蒂。"}
        ]},
        {"en": "Good morning!", "cn": "早上好！", "examples": [
          {"en": "Good morning, Miss Li.", "cn": "早上好，李老师。"},
          {"en": "Good afternoon, Peter.", "cn": "下午好，彼得。"}
        ]}
      ],
      "grammar": [
        {"title": "be 动词：I am / You are", "explain": "表示「是」的时候，主语是 I 用 am，主语是 you 用 are。口语里常缩写成 I'm、you're。", "examples": [
          {"en": "I am a pupil.", "cn": "我是一名小学生。"},
          {"en": "You are my friend.", "cn": "你是我的朋友。"}
        ]},
        {"title": "大写规则", "explain": "英语中 I（我）任何位置都要大写；人名、老师的姓（Miss Li）首字母也要大写。", "examples": [
          {"en": "Amy and I are friends.", "cn": "艾米和我是朋友。"}
        ]}
      ],
      "tips": ["课堂用语：Stand up, please. 请起立。", "课堂用语：Sit down, please. 请坐下。"]
    },
    {
      "id": "g1u2",
      "no": 2,
      "title_en": "Colours",
      "title_cn": "颜色",
      "topic": "Colours",
      "overview": "认识常见颜色词，会说「这是什么颜色」并描述身边物品的颜色。",
      "phonics": {
        "focus": "字母 Bb /b/ 和 Cc /k/",
        "tip": "/b/ 双唇紧闭再爆开；/k/ 舌根抬起抵住软腭再放开。",
        "examples": ["blue /bluː/ 蓝色", "cap /kæp/ 帽子", "book /bʊk/ 书"]
      },
      "words": [
        {"en": "red", "ipa": "/red/", "pos": "adj./n.", "cn": "红色（的）", "ex_en": "The apple is red.", "ex_cn": "这个苹果是红色的。"},
        {"en": "yellow", "ipa": "/ˈjeləʊ/", "pos": "adj./n.", "cn": "黄色（的）", "ex_en": "I have a yellow pen.", "ex_cn": "我有一支黄色的笔。"},
        {"en": "blue", "ipa": "/bluː/", "pos": "adj./n.", "cn": "蓝色（的）", "ex_en": "The sky is blue.", "ex_cn": "天空是蓝色的。"},
        {"en": "green", "ipa": "/ɡriːn/", "pos": "adj./n.", "cn": "绿色（的）", "ex_en": "The tree is green.", "ex_cn": "这棵树是绿色的。"},
        {"en": "black", "ipa": "/blæk/", "pos": "adj./n.", "cn": "黑色（的）", "ex_en": "My bag is black.", "ex_cn": "我的书包是黑色的。"},
        {"en": "white", "ipa": "/waɪt/", "pos": "adj./n.", "cn": "白色（的）", "ex_en": "I like white shoes.", "ex_cn": "我喜欢白色的鞋子。"},
        {"en": "orange", "ipa": "/ˈɒrɪndʒ/", "pos": "adj./n.", "cn": "橙色（的）；橙子", "ex_en": "This is an orange cap.", "ex_cn": "这是一顶橙色的帽子。"},
        {"en": "pink", "ipa": "/pɪŋk/", "pos": "adj./n.", "cn": "粉色（的）", "ex_en": "The flower is pink.", "ex_cn": "这朵花是粉色的。"},
        {"en": "colour", "ipa": "/ˈkʌlə/", "pos": "n.", "cn": "颜色", "ex_en": "What colour is it?", "ex_cn": "它是什么颜色的？"},
        {"en": "brown", "ipa": "/braʊn/", "pos": "adj./n.", "cn": "棕色（的）", "ex_en": "The bear is brown.", "ex_cn": "这只熊是棕色的。"}
      ],
      "patterns": [
        {"en": "What colour is it?", "cn": "它是什么颜色的？", "examples": [
          {"en": "What colour is it?", "cn": "它是什么颜色的？"},
          {"en": "It is red.", "cn": "它是红色的。"}
        ]},
        {"en": "I like ... .", "cn": "我喜欢……。", "examples": [
          {"en": "I like blue.", "cn": "我喜欢蓝色。"},
          {"en": "I like green and white.", "cn": "我喜欢绿色和白色。"}
        ]},
        {"en": "This is a ... bag.", "cn": "这是一个……颜色的书包。", "examples": [
          {"en": "This is a black bag.", "cn": "这是一个黑色的书包。"},
          {"en": "This is a pink flower.", "cn": "这是一朵粉色的花。"}
        ]}
      ],
      "grammar": [
        {"title": "颜色词放在名词前面", "explain": "英语里表示颜色的词放在名词前：a red apple（一个红苹果），不能说 an apple red。", "examples": [
          {"en": "a green tree", "cn": "一棵绿树"},
          {"en": "a yellow pen", "cn": "一支黄笔"}
        ]},
        {"title": "a 还是 an", "explain": "名词前的词以元音音素开头用 an，其它用 a：an orange cap，a red cap。", "examples": [
          {"en": "an orange bag", "cn": "一个橙色的书包"},
          {"en": "a white cap", "cn": "一顶白帽子"}
        ]}
      ],
      "tips": ["深圳的校服常见蓝白两色，可以用 My uniform is blue and white. 来描述。"]
    },
    {
      "id": "g1u3",
      "no": 3,
      "title_en": "Numbers 1-10",
      "title_cn": "数字 1-10",
      "topic": "Numbers",
      "overview": "学会 1 到 10 的英文说法，会数身边的物品并回答「有几个」。",
      "phonics": {
        "focus": "字母 Ee 的短音 /e/",
        "tip": "嘴角微微向两边，声音短促，如 ten /ten/。",
        "examples": ["ten /ten/ 十", "pen /pen/ 钢笔", "red /red/ 红色"]
      },
      "words": [
        {"en": "one", "ipa": "/wʌn/", "pos": "num.", "cn": "一", "ex_en": "I have one book.", "ex_cn": "我有一本书。"},
        {"en": "two", "ipa": "/tuː/", "pos": "num.", "cn": "二", "ex_en": "I see two birds.", "ex_cn": "我看见两只鸟。"},
        {"en": "three", "ipa": "/θriː/", "pos": "num.", "cn": "三", "ex_en": "There are three pens.", "ex_cn": "有三支笔。"},
        {"en": "four", "ipa": "/fɔː/", "pos": "num.", "cn": "四", "ex_en": "I am four years old.", "ex_cn": "我四岁。"},
        {"en": "five", "ipa": "/faɪv/", "pos": "num.", "cn": "五", "ex_en": "Give me five apples.", "ex_cn": "给我五个苹果。"},
        {"en": "six", "ipa": "/sɪks/", "pos": "num.", "cn": "六", "ex_en": "I am six.", "ex_cn": "我六岁。"},
        {"en": "seven", "ipa": "/ˈsevn/", "pos": "num.", "cn": "七", "ex_en": "Seven days make a week.", "ex_cn": "七天是一周。"},
        {"en": "eight", "ipa": "/eɪt/", "pos": "num.", "cn": "八", "ex_en": "I have eight crayons.", "ex_cn": "我有八支蜡笔。"},
        {"en": "nine", "ipa": "/naɪn/", "pos": "num.", "cn": "九", "ex_en": "Nine plus one is ten.", "ex_cn": "九加一等于十。"},
        {"en": "ten", "ipa": "/ten/", "pos": "num.", "cn": "十", "ex_en": "Count to ten, please.", "ex_cn": "请数到十。"}
      ],
      "patterns": [
        {"en": "How many ... ?", "cn": "有多少个……？", "examples": [
          {"en": "How many books?", "cn": "有多少本书？"},
          {"en": "How many pens do you have?", "cn": "你有多少支笔？"}
        ]},
        {"en": "I have ... .", "cn": "我有……。", "examples": [
          {"en": "I have three pens.", "cn": "我有三支笔。"},
          {"en": "I have two friends.", "cn": "我有两个朋友。"}
        ]},
        {"en": "I am ... years old.", "cn": "我……岁。", "examples": [
          {"en": "I am six years old.", "cn": "我六岁。"},
          {"en": "I am seven years old.", "cn": "我七岁。"}
        ]}
      ],
      "grammar": [
        {"title": "名词复数加 -s", "explain": "数量超过一个时，可数名词后面要加 -s：one book → two books，one pen → five pens。", "examples": [
          {"en": "one apple, two apples", "cn": "一个苹果，两个苹果"},
          {"en": "three birds", "cn": "三只鸟"}
        ]},
        {"title": "How many 后面接复数", "explain": "How many 用来问数量，后面跟名词复数：How many books?", "examples": [
          {"en": "How many cats?", "cn": "有几只猫？"}
        ]}
      ],
      "tips": ["数数时可以拍手打节奏，帮助记住 /θ/ 在 three 里的咬舌音。"]
    },
